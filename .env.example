# Redis connection string (required for hot session state)
LM_PROXY_REDIS_URL=redis://localhost:6379/0

# Postgres / pgvector (codebase embeddings + conversation persistence)
LM_PROXY_PG_DSN=postgresql://USER@/lm_proxy_memory?host=/tmp
LM_PROXY_MEMORY_ENABLE_PERSISTENCE=1

# Vector embeddings (model must be loaded in LM Studio)
LM_PROXY_MEMORY_ENABLE_EMBEDDINGS=1
LM_PROXY_MEMORY_EMBEDDING_MODEL=text-embedding-jina-embeddings-v2-base-code
LM_PROXY_MEMORY_EMBEDDING_DIM=768
LM_EMBED_BATCH_SIZE=256
LM_PROXY_MEMORY_MODE=hybrid
LM_PROXY_MEMORY_MAX_INJECT_TURNS=6
LM_PROXY_USE_RESPONSES_API=1
# Tool results: don't truncate — model has 262K context and read tool manages its own pagination
LM_PROXY_MAX_TOOL_MESSAGE_CHARS=200000
LM_PROXY_DOCS_MAX_REQUESTS=200
LM_PROXY_TS_PACK_CACHE_DIR=/Users/USER/.cache/ts-pack
TS_PACK_SWIFT_IMPLICIT_IMPORTS=1
TS_PACK_PY_ATTR_CALLS=1
TS_PACK_LAUNCH_EDGES=1
TS_PACK_DEBUG_LAUNCH=0
LM_PROXY_CLONE_DEDUP=1
LM_PROXY_CLONE_NEAR_EDGE=0
LM_PROXY_CLONE_DEBUG=1
LM_PROXY_FILE_CLONE_SOURCE=hybrid

# Duplication tool defaults (same-file noise control)
LM_PROXY_DUPLICATION_SAME_FILE_MIN_TOKENS=20
LM_PROXY_DUPLICATION_MAX_SAME_FILE_PAIRS_PER_FILE=8


# --- To disable memory entirely ---
# LM_PROXY_MEMORY_ENABLED=0

# --- Graph Search (Neo4j) ---
LM_PROXY_GRAPH_ENABLED=1
LM_PROXY_NEO4J_URI=bolt://localhost:7687
LM_PROXY_NEO4J_USER=neo4j
LM_PROXY_NEO4J_PASSWORD=CHANGEME
LM_PROXY_NEO4J_DB=proxy
LM_PROXY_DEBUG=true
PYTHONUNBUFFERED=1
LM_PROXY_NEO4J_WRITE_TIMEOUT=15
LM_PROXY_NEO4J_GDS_TIMEOUT=120
LM_PROXY_NEO4J_TX_TIMEOUT=30
LM_PROXY_NEO4J_OP_PREFIX=lmproxy
LM_PROXY_GRAPH_BUILD_LOCK_REDIS=1
LM_PROXY_GRAPH_BUILD_LOCK_TTL=300
LM_PROXY_GRAPH_BUILD_LOCK_WAIT=30
LM_PROXY_GRAPH_BUILD_LOCK_POLL=0.2
LM_PROXY_GRAPH_BUILD_LOCK_RENEW=20

TAVILY_API_KEY=YOUR_KEY_HERE
