stGenerationRequest ?? \"No generation request available\"\n140:         case .layerInfo:\n141:             guard let selectedLayer = stateStore?.selectedLayerInfo else {\n142:                 value = \"No layer selected\"\n143:                 return CopyCommandResult(command: command, success: false, message: value)\n144:             }\n145:             value = selectedLayer.toJSONString() ?? \"Failed to serialize layer info\"\n146:         case .protectedCircle:\n147:             guard let protectedCircle = stateStore?.protectedCircleInfo else {\n148:                 value = \"No protected circle available\"\n149:                 return CopyCommandResult(command: command, success: false, message: value)\n150:             }\n151:             value = protectedCircle.toJSONString() ?? \"Failed to serialize protected circle\"\n152:         case .chartGeometry:\n153:             guard let chartGeometry = stateStore?.chartGeometryInfo else {\n154:                 value = \"No chart geometry available\"\n155:                 return CopyCommandResult(command: command, success: false, message: value)\n156:             }\n157:             value = chartGeometry.toJSONString() ?? \"Failed to serialize chart geometry\"\n158:         }\n159:         \n160:         copyToPasteboard(value)\n161:         return CopyCommandResult(command: command, success: true, message: \"Copied to pasteboard\")\n162:     }\n163: }\n164: #endif\n\n(End of file - total 164 lines)\n</content>","role":"tool","tool_call_id":"623137259"},"message":"dumping_raw_messages"}
