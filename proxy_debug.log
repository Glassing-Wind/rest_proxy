ne(id: UUID) {\n1126:         guideLines.removeAll { $0.id == id }\n1127:         if selectedGuideLineID == id {\n1128:             selectedGuideLineID = nil\n1129:         }\n1130:     }\n1131: \n1132:     func selectGuideLine(id: UUID) {\n1133:         guard guideLines.contains(where: { $0.id == id }) else {\n1134:             selectedGuideLineID = nil\n1135:             return\n1136:         }\n1137:         selectedGuideLineID = id\n1138:     }\n1139: \n1140:     func createProtectedCircle() {\n1141:         let protectedCircle = ProtectedCircle(\n1142:             center: chartGeometry?.center ?? CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0),\n1143:             radius: estimatedInnerChartRadius,\n1144:             isVisible: true,\n1145:             isLocked: false,\n1146:             name: \"Black Circle of Doom\"\n1147:         )\n1148: \n1149:         protectedCircles.append(protectedCircle)\n1150:         selectedProtectedCircleID = protectedCircle.id\n1151:     }\n1152: \n1153:     func removeProtectedCircle(id: UUID) {\n1154:         protectedCircles.removeAll { $0.id == id }\n1155:         if selectedProtectedCircleID == id {\n1156:             selectedProtectedCircleID = nil\n1157:         }\n1158:     }\n1159: \n1160:     func selectProtectedCircle(id: UUID) {\n1161:         guard protectedCircles.contains(where: { $0.id == id }) else {\n1162:             selectedProtectedCircleID = nil\n1163:             return\n1164:         }\n1165:         selectedProtectedCircleID = id\n1166:     }\n1167: \n1168:     func snapProtectedCircleToInnerChartBounds() {\n1169:         guard let index = selectedProtectedCircleIndex else {\n1170:             return\n1171:         }\n1172: \n1173:         protectedCircles[index].center = chartGeometry?.center ?? CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n1174:         protectedCircles[index].radius = estimatedInnerChartRadius\n1175:     }\n1176: \n1177:     func snapProtectedCircleToOuterChartBounds() {\n1178:  