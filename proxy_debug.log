    settingsViewModel.backendConfig.serverHost\n254:     }\n255: \n256:     var serverPort: Int {\n257:         settingsViewModel.backendConfig.serverPort\n258:     }\n259: \n260:     var serverExecutablePath: String {\n261:         settingsViewModel.backendConfig.serverExecutablePath\n262:     }\n263: \n264:     var modelsDirectoryPath: String {\n265:         settingsViewModel.backendConfig.modelsDirectoryPath\n266:     }\n267: \n268:     var autoLaunchServer: Bool {\n269:         settingsViewModel.backendConfig.autoLaunchServer\n270:     }\n271: \n272:     var enableServerDebugLogging: Bool {\n273:         settingsViewModel.backendConfig.enableDebugLogging\n274:     }\n275: \n276:     var enablePromptUpsampler: Bool {\n277:         settingsViewModel.backendConfig.enablePromptUpsampler\n278:     }\n279: \n280:     var promptUpsamplerEndpoint: String {\n281:         settingsViewModel.backendConfig.promptUpsamplerEndpoint\n282:     }\n283: \n284:     var promptUpsamplerModel: String {\n285:         settingsViewModel.backendConfig.promptUpsamplerModel\n286:     }\n287: \n288:     var promptUpsamplerTimeoutSeconds: Int {\n289:         settingsViewModel.backendConfig.promptUpsamplerTimeoutSeconds\n290:     }\n291: \n292:     var generationIdleTimeoutMinutes: Int {\n293:         settingsViewModel.backendConfig.generationIdleTimeoutMinutes\n294:     }\n295: \n296:     func updateServerHost(_ value: String) {\n297:         settingsViewModel.backendConfig.serverHost = sanitizeServerSetting(value)\n298:         settingsViewModel.saveDefaults()\n299:     }\n300: \n301:     func updateServerPort(_ value: Int) {\n302:         settingsViewModel.backendConfig.serverPort = value\n303:         settingsViewModel.saveDefaults()\n304:     }\n305: \n306:     func updateServerExecutablePath(_ value: String) {\n307:         settingsViewModel.backendConfig.serverExecutablePath = sanitizeServerSetting(value)\n308:         settingsViewModel.saveDefaults()\n309:     }\n310: \n311:     func updateModelsDirectoryPath(_ value: String) {\n312:         settingsViewModel.backendConfig.modelsDirectoryPath = sanitizeServerSetting(value)\n313:         settingsViewModel.saveDefaults()\n314:     }\n315: \n316:     func updateAutoLaunchServer(_ value: Bool) {\n317:         settingsViewModel.backendConfig.autoLaunchServer = value\n318:         settingsViewModel.saveDefaults()\n319:     }\n320: \n321:     func updateServerDebugLogging(_ value: Bool) {\n322:         settingsViewModel.backendConfig.enableDebugLogging = value\n323:         settingsViewModel.saveDefaults()\n324:         refreshGenerationBackend()\n325:     }\n326: \n327:     func updateGenerationPrompt(_ value: String) {\n328:         generationPrompt = value\n329:         generationSettings.upsampledPromptPreview = \"\"\n330:     }\n331: \n332:     func updateGenerationNegativePrompt(_ value: String) {\n333:         generationNegativePrompt = value\n334:         generationSettings.upsampledPromptPreview = \"\"\n335:     }\n336: \n337:     func clearUpsampledPromptPreview() {\n338:         generationSettings.upsampledPromptPreview = \"\"\n339:     }\n340: \n341:     func selectGenerationModel(_ model: String) {\n342:         let trimmedModel = model.trimmingCharacters(in: .whitespacesAndNewlines)\n343:         guard !trimmedModel.isEmpty else {\n344:             return\n345:         }\n346:         guard !isDownloadingModel else {\n347:             return\n348:         }\n349:         guard generationSettings.modelName != trimmedModel else {\n350:             return\n351:         }\n352: \n353:         if backendType != .localDrawThingsServer || isModelAvailableLocally(trimmedModel) {\n354:             generationSettings.modelName = trimmedModel\n355:             pendingModelDownloadPrompt = nil\n356:             previousSelectedModelName = nil\n357:             return\n358:         }\n359: \n360:         let previousModel = generationSettings.modelName\n361:         previousSelectedModelName = previousModel\n362:         pendingModelDownloadPrompt = MissingModelPromptState(\n363:             requestedModelName: trimmedModel,\n364:             previousModelName: previousModel\n365:         )\n366:     }\n367: \n368:     func cancelModelDownloadPrompt() {\n369:         guard let prompt = pendingModelDownloadPrompt else {\n370:             return\n371:         }\n372:         pendingModelDownloadPrompt = nil\n373:         generationSettings.modelName = previousSelectedModelName ?? prompt.previousModelName\n374:         previousSelectedModelName = nil\n375:         modelDownloadStatusMessage = nil\n376:         modelDownloadProgress = nil\n377:     }\n378: \n379:     func confirmModelDownload() {\n380:         guard let prompt = pendingModelDownloadPrompt else {\n381:             return\n382:         }\n383:         guard !isDownloadingModel else {\n384:             return\n385:         }\n386: \n387:         pendingModelDownloadPrompt = nil\n388:         isDownloadingModel = true\n389:         modelDownloadStatusMessage = \"Preparing download…\"\n390:         modelDownloadProgress = 0.0\n391:         lastErrorMessage = nil\n392: \n393:         let requestedModel = prompt.requestedModelName\n394:         let previousModel = previousSelectedModelName ?? prompt.previousModelName\n395:         previousSelectedModelName = previousModel\n396: \n397:         Task {\n398:             defer {\n399:                 isDownloadingModel = false\n400:             }\n401:             do {\n402:                 let client = DrawThingsServerClient(\n403:                     host: serverHost,\n404:                     port: serverPort,\n405:                     debugLoggingEnabled: enableServerDebugLogging,\n406:                     generationIdleTimeoutMinutes: generationIdleTimeoutMinutes\n407:                 )\n408:                 try await client.downloadModelIfNeeded(\n409:                     modelFileName: requestedModel,\n410:                     onStatus: { status in\n411:                         Task { @MainActor in\n412:                             self.modelDownloadStatusMessage = status\n413:                         }\n414:                     },\n415:                     onProgress: { progress in\n416:                         Task { @MainActor in\n417:                             self.modelDownloadProgress = progress\n418:                         }\n419:                     }\n420:                 )\n421:                 refreshAvailableGenerationModels()\n422:                 if isModelAvailableLocally(requestedModel) {\n423:                     generationSettings.modelName = requestedModel\n424:                     previousSelectedModelName = nil\n425:                     modelDownloadStatusMessage = nil\n426:                     modelDownloadProgress = nil\n427:                 } else {\n428:                     generationSettings.modelName = previousModel\n429:                     lastErrorMessage = \"Model download completed, but the model is still unavailable locally. Refresh models and try again.\"\n430:                     modelDownloadStatusMessage = nil\n431:                     modelDownloadProgress = nil\n432:                 }\n433:             } catch {\n434:                 generationSettings.modelName = previousModel\n435:                 modelDownloadStatusMessage = nil\n436:                 modelDownloadProgress = nil\n437:                 previousSelectedModelName = nil\n438:                 lastErrorMessage =\n439:                     \"Could not download model. Ensure Draw Things remote model download is enabled, then try again.\"\n440:             }\n441:         }\n442:     }\n443: \n444:     func isModelAvailableLocally(_ model: String) -> Bool {\n445:         let modelsURL = resolvedModelsDirectoryURL()\n446:         let didStartScopedAccess = modelsURL.startAccessingSecurityScopedResource()\n447:         defer {\n448:             if didStartScopedAccess {\n449:                 modelsURL.stopAccessingSecurityScopedResource()\n450:             }\n451:         }\n452:         return DrawThingsModelPreflight.isModelAvailableLocally(\n453:             modelName: model,\n454:             availableModelNames: availableGenerationModelNames,\n455:             modelsDirectoryURL: modelsURL\n456:         )\n457:     }\n458: \n459:     func upsamplePromptNow() {\n460:         guard !isUpsamplingPrompt else {\n461:             return\n462:         }\n463:         let basePrompt = generationPrompt.trimmingCharacters(in: .whitespacesAndNewlines)\n464:         guard !basePrompt.isEmpty else {\n465:             return\n466:         }\n467: \n468:         isUpsamplingPrompt = true\n469:         lastErrorMessage = nil\n470: \n471:         Task {\n472:             defer {\n473:                 isUpsamplingPrompt = false\n474:             }\n475:             do {\n476:                 let upsamplingService = PromptUpsamplingService()\n477:                 let upsampledPrompt = try await upsamplingService.upsamplePrompt(\n478:                     prompt: basePrompt,\n479:                     negativePrompt: generationNegativePrompt,\n480:                     config: .init(\n481:                         endpoint: promptUpsamplerEndpoint,\n482:                         model: promptUpsamplerModel,\n483:                         timeoutSeconds: promptUpsamplerTimeoutSeconds\n484:                     )\n485:                 )\n486:                 generationSettings.upsampledPromptPreview = upsampledPrompt\n487:             } catch {\n488:                 let message = (error as? LocalizedError)?.errorDescription ?? error.localizedDescription\n489:                 lastErrorMessage = message\n490:             }\n491:         }\n492:     }\n493: \n494:     func updateEnablePromptUpsampler(_ value: Bool) {\n495:         settingsViewModel.backendConfig.enablePromptUpsampler = value\n496:         settingsViewModel.saveDefaults()\n497:     }\n498: \n499:     func updatePromptUpsamplerEndpoint(_ value: String) {\n500:         settingsViewModel.backendConfig.promptUpsamplerEndpoint = sanitizeServerSetting(value)\n501:         settingsViewModel.saveDefaults()\n502:     }\n503: \n504:     func updatePromptUpsamplerModel(_ value: String) {\n505:         settingsViewModel.backendConfig.promptUpsamplerModel = sanitizeServerSetting(value)\n506:         settingsViewModel.saveDefaults()\n507:     }\n508: \n509:     func updatePromptUpsamplerTimeoutSeconds(_ value: Int) {\n510:         settingsViewModel.backendConfig.promptUpsamplerTimeoutSeconds = max(3, min(600, value))\n511:         settingsViewModel.saveDefaults()\n512:     }\n513: \n514:     func testServerLaunchCommand() {\n515:         guard let localServerService else {\n516:             lastErrorMessage = \"Local server backend is not active.\"\n517:             return\n518:         }\n519:         lastErrorMessage = localServerService.testLaunchCommand()\n520:     }\n521: \n522:     func importReferenceImage(role: ReferenceRole) {\n523:         guard let image = imageImportService.importImage() else {\n524:             return\n525:         }\n526: \n527:         addReference(image: image, name: defaultReferenceName(for: role), role: role)\n528:     }\n529: \n530:     func importReferenceImage() {\n531:         importReferenceImage(role: .structure)\n532:     }\n533: \n534:     func importMaskImage() {\n535:         guard let image = imageImportService.importImage() else {\n536:             return\n537:         }\n538: \n539:         applyImportedMask(image)\n540:     }\n541: \n542:     func handleDroppedImage(url: URL, role: ReferenceRole) {\n543:         guard let image = imageImportService.loadImage(from: url) else {\n544:             return\n545:         }\n546: \n547:         addReference(\n548:             image: image,\n549:             name: url.deletingPathExtension().lastPathComponent,\n550:             role: role\n551:         )\n552:     }\n553: \n554:     func handleDroppedImage(url: URL) {\n555:         handleDroppedImage(url: url, role: .structure)\n556:     }\n557: \n558:     func handleDroppedArtImage(url: URL) {\n559:         guard let image = imageImportService.loadImage(from: url) else {\n560:             return\n561:         }\n562: \n563:         let normalizedImage = normalizedArtImageForCanvas(image)\n564:         createArtLayer(from: normalizedImage, name: url.deletingPathExtension().lastPathComponent, isGenerated: false)\n565:     }\n566: \n567:     func handleDroppedMaskImage(url: URL) {\n568:         guard let image = imageImportService.loadImage(from: url) else {\n569:             return\n570:         }\n571: \n572:         applyImportedMask(image)\n573:     }\n574: \n575:     func removeReference(id: UUID) {\n576:         referenceLayers.removeAll { $0.id == id }\n577:         normalizeReferenceOrder()\n578:     }\n579: \n580:     func clearReferences() {\n581:         referenceLayers.removeAll()\n582:     }\n583: \n584:     func clearReferenceImage() {\n585:         clearReferences()\n586:     }\n587: \n588:     func moveReference(fromOffsets: IndexSet, toOffset: Int) {\n589:         var sortedLayers = referenceLayers.sorted { $0.order < $1.order }\n590:         sortedLayers.move(fromOffsets: fromOffsets, toOffset: toOffset)\n591:         referenceLayers = sortedLayers.enumerated().map { index, layer in\n592:             var updatedLayer = layer\n593:             updatedLayer.order = index\n594:             return updatedLayer\n595:         }\n596:     }\n597: \n598:     func setReferenceOpacity(id: UUID, value: Double) {\n599:         guard let index = referenceLayers.firstIndex(where: { $0.id == id }) else {\n600:             return\n601:         }\n602: \n603:         referenceLayers[index].opacity = max(0.0, min(1.0, value))\n604:     }\n605: \n606:     func toggleReferenceVisibility(id: UUID) {\n607:         guard let index = referenceLayers.firstIndex(where: { $0.id == id }) else {\n608:             return\n609:         }\n610: \n611:         referenceLayers[index].isVisible.toggle()\n612:     }\n613: \n614:     func toggleReferenceLock(id: UUID) {\n615:         guard let index = referenceLayers.firstIndex(where: { $0.id == id }) else {\n616:             return\n617:         }\n618: \n619:         referenceLayers[index].isLocked.toggle()\n620:     }\n621: \n622:     func setReferenceRole(id: UUID, role: ReferenceRole) {\n623:         guard let index = referenceLayers.firstIndex(where: { $0.id == id }) else {\n624:             return\n625:         }\n626: \n627:         if role == .structure {\n628:             referenceLayers.removeAll { $0.role == .structure && $0.id != id }\n629:             if let refreshedIndex = referenceLayers.firstIndex(where: { $0.id == id }) {\n630:                 referenceLayers[refreshedIndex].role = role\n631:             }\n632:         } else {\n633:             referenceLayers[index].role = role\n634:         }\n635: \n636:         normalizeReferenceOrder()\n637:     }\n638: \n639:     func createEmptyArtLayer() {\n640:         let image = makeTransparentImage(size: CGSize(width: canvasSize, height: canvasSize))\n641:         createArtLayer(from: image, name: \"Art Layer \\(artLayers.count + 1)\", isGenerated: false)\n642:     }\n643: \n644:     @discardableResult\n645:     func createGeneratedArtLayer(image: NSImage) -> UUID {\n646:         let layerID = createArtLayer(from: image, name: \"Generated Layer \\(artLayers.count + 1)\", isGenerated: true)\n647:         guard let index = artLayers.firstIndex(where: { $0.id == layerID }) else {\n648:             return layerID\n649:         }\n650:         artLayers[index].position = CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n651:         artLayers[index].scale = 1.0\n652:         return layerID\n653:     }\n654: \n655:     func selectSingleArtLayer(id: UUID) {\n656:         guard let layer = artLayers.first(where: { $0.id == id }) else {\n657:             selectedArtLayerID = nil\n658:             selectedArtLayerIDs = []\n659:             artLayerSelectionOrder = []\n660:             frameMaskLayer = nil\n661:             return\n662:         }\n663: \n664:         DispatchQueue.main.async { [weak self] in\n665:             guard let self else { return }\n666: \n667:             self.selectedArtLayerID = id\n668:             self.selectedArtLayerIDs = [id]\n669:             self.artLayerSelectionOrder = [id]\n670: \n671:             if let existingMask = self.artLayerMasks[id] {\n672:                 self.frameMaskLayer = existingMask\n673:             } else {\n674:                 let newMask = MaskUtilities.makeWhiteMask(size: layer.image.size)\n675:                 self.artLayerMasks[id] = newMask\n676:                 self.frameMaskLayer = newMask\n677:             }\n678:         }\n679:     }\n680: \n681:     func selectArtLayer(id: UUID) {\n682:         selectSingleArtLayer(id: id)\n683:     }\n684: \n685:     func toggleArtLayerSelection(id: UUID) {\n686:         guard artLayers.contains(where: { $0.id == id }) else {\n687:             return\n688:         }\n689: \n690:         if selectedArtLayerIDs.contains(id) {\n691:             selectedArtLayerIDs.remove(id)\n692:             artLayerSelectionOrder.removeAll { $0 == id }\n693:             if selectedArtLayerID == id {\n694:                 selectedArtLayerID = artLayerSelectionOrder.last ?? selectedArtLayerIDs.first\n695:             }\n696:         } else {\n697:             selectedArtLayerIDs.insert(id)\n698:             artLayerSelectionOrder.removeAll { $0 == id }\n699:             artLayerSelectionOrder.append(id)\n700:             selectedArtLayerID = id\n701:         }\n702: \n703:         syncPrimarySelectionWithMask()\n704:     }\n705: \n706:     func clearArtLayerSelection() {\n707:         selectedArtLayerID = nil\n708:         selectedArtLayerIDs = []\n709:         artLayerSelectionOrder = []\n710:         frameMaskLayer = nil\n711:     }\n712: \n713:     func selectAllArtLayers() {\n714:         let ordered = sortedArtLayers.map(\\.id)\n715:         selectedArtLayerIDs = Set(ordered)\n716:         artLayerSelectionOrder = ordered\n717:         selectedArtLayerID = ordered.last\n718:         syncPrimarySelectionWithMask()\n719:     }\n720: \n721:     func setPrimarySelectedArtLayer(id: UUID) {\n722:         guard selectedArtLayerIDs.contains(id), artLayers.contains(where: { $0.id == id }) else {\n723:             return\n724:         }\n725: \n726:         selectedArtLayerID = id\n727:         artLayerSelectionOrder.removeAll { $0 == id }\n728:         artLayerSelectionOrder.append(id)\n729:         syncPrimarySelectionWithMask()\n730:     }\n731: \n732:     func removeArtLayer(id: UUID) {\n733:         artLayers.removeAll { $0.id == id }\n734:         artLayerMasks[id] = nil\n735:         selectedArtLayerIDs.remove(id)\n736:         artLayerSelectionOrder.removeAll { $0 == id }\n737: \n738:         let primaryStillSelected = selectedArtLayerID.flatMap { selectedArtLayerIDs.contains($0) } ?? false\n739:         if selectedArtLayerID == id || !primaryStillSelected {\n740:             selectedArtLayerID = artLayerSelectionOrder.last ?? selectedArtLayerIDs.first\n741:         }\n742: \n743:         normalizeArtLayerOrder()\n744:         syncPrimarySelectionWithMask()\n745:     }\n746: \n747:     func removeSelectedArtLayers() {\n748:         let idsToRemove: Set<UUID>\n749:         if selectedArtLayerIDs.count > 1 {\n750:             idsToRemove = selectedArtLayerIDs\n751:         } else if let selectedArtLayerID {\n752:             idsToRemove = [selectedArtLayerID]\n753:         } else {\n754:             return\n755:         }\n756: \n757:         artLayers.removeAll { idsToRemove.contains($0.id) }\n758:         for id in idsToRemove {\n759:             artLayerMasks[id] = nil\n760:         }\n761: \n762:         selectedArtLayerIDs.subtract(idsToRemove)\n763:         artLayerSelectionOrder.removeAll { idsToRemove.contains($0) }\n764:         selectedArtLayerID = artLayerSelectionOrder.last ?? selectedArtLayerIDs.first\n765:         normalizeArtLayerOrder()\n766:         syncPrimarySelectionWithMask()\n767:     }\n768: \n769:     func moveArtLayerUp(id: UUID) {\n770:         var ordered = sortedArtLayers\n771:         guard let index = ordered.firstIndex(where: { $0.id == id }), index < ordered.count - 1 else {\n772:             return\n773:         }\n774: \n775:         ordered.swapAt(index, index + 1)\n776:         applyArtLayerOrder(ordered)\n777:     }\n778: \n779:     func moveArtLayerDown(id: UUID) {\n780:         var ordered = sortedArtLayers\n781:         guard let index = ordered.firstIndex(where: { $0.id == id }), index > 0 else {\n782:             return\n783:         }\n784: \n785:         ordered.swapAt(index, index - 1)\n786:         applyArtLayerOrder(ordered)\n787:     }\n788: \n789:     func flattenArtLayers() {\n790:         guard let flattened = exportService.renderMergedArtLayers(\n791:             artLayers: sortedArtLayers,\n792:             masks: artLayerMasks,\n793:             canvasSize: canvasSize\n794:         ) else {\n795:             return\n796:         }\n797: \n798:         artLayers = [\n799:             ArtLayer(\n800:                 image: flattened,\n801:                 name: \"Flattened Layer\",\n802:                 isVisible: true,\n803:                 isLocked: false,\n804:                 opacity: 1.0,\n805:                 position: CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0),\n806:                 scale: 1.0,\n807:                 rotation: 0.0,\n808:                 zIndex: 0,\n809:                 isGenerated: false,\n810:                 respectsProtectedCircle: true\n811:             )\n812:         ]\n813: \n814:         if let flattenedID = artLayers.first?.id {\n815:             artLayerMasks = [flattenedID: MaskUtilities.makeWhiteMask(size: flattened.size)]\n816:             selectArtLayer(id: flattenedID)\n817:         }\n818:     }\n819: \n820:     func moveSelectedLayer(delta: CGSize) {\n821:         guard let index = selectedArtLayerIndex else {\n822:             return\n823:         }\n824: \n825:         artLayers[index].position.x += delta.width\n826:         artLayers[index].position.y += delta.height\n827:     }\n828: \n829:     func centerSelectedArtLayer() {\n830:         guard let index = selectedArtLayerIndex else {\n831:             return\n832:         }\n833: \n834:         artLayers[index].position = CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n835:     }\n836: \n837:     func fitSelectedArtLayerToCanvas() {\n838:         guard let index = selectedArtLayerIndex else {\n839:             return\n840:         }\n841: \n842:         let imageSize = artLayers[index].image.size\n843:         guard imageSize.width > 0, imageSize.height > 0 else {\n844:             return\n845:         }\n846: \n847:         let baseRect = fittedRect(for: imageSize, inside: CGSize(width: canvasSize, height: canvasSize))\n848:         let longestSide = max(baseRect.width, baseRect.height)\n849:         guard longestSide > 0 else {\n850:             return\n851:         }\n852: \n853:         let fitScale = canvasSize / longestSide\n854:         artLayers[index].scale = max(0.1, min(8.0, fitScale))\n855:         centerSelectedArtLayer()\n856:     }\n857: \n858:     func normalizeSelectedArtLayerScale() {\n859:         guard let index = selectedArtLayerIndex else {\n860:             return\n861:         }\n862: \n863:         artLayers[index].scale = 1.0\n864:     }\n865: \n866:     func centerAllArtLayers() {\n867:         let centerPoint = CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n868:         for index in artLayers.indices {\n869:             artLayers[index].position = centerPoint\n870:         }\n871:     }\n872: \n873:     func scaleSelectedLayer(factor: CGFloat) {\n874:         guard let index = selectedArtLayerIndex else {\n875:             return\n876:         }\n877: \n878:         artLayers[index].scale = max(0.1, min(8.0, artLayers[index].scale * factor))\n879:     }\n880: \n881:     func rotateSelectedLayer(angle: CGFloat) {\n882:         guard let index = selectedArtLayerIndex else {\n883:             return\n884:         }\n885: \n886:         artLayers[index].rotation += angle\n887:     }\n888: \n889:     func toggleSelectedArtLayerProtectedCircleRespect() {\n890:         guard let index = selectedArtLayerIndex else {\n891:             return\n892:         }\n893: \n894:         artLayers[index].respectsProtectedCircle.toggle()\n895:     }\n896: \n897:     // Angle convention: point index 0 starts at radialStartAngleDegrees and advances by radialClockwise.\n898:     func placeSelectedArtLayerOnRadialPoint(count: Int, index: Int, radius: CGFloat, autoRotateTowardCenter: Bool) {\n899:         guard count > 0, let artLayerIndex = selectedArtLayerIndex else {\n900:             return\n901:         }\n902: \n903:         let center = CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n904:         let normalizedIndex = ((index % count) + count) % count\n905:         let stepDirection: CGFloat = radialClockwise ? 1.0 : -1.0\n906:         let angle = (radialStartAngleDegrees * .pi / 180.0) + (stepDirection * 2.0 * .pi * CGFloat(normalizedIndex) / CGFloat(count))\n907:         let x = center.x + cos(angle) * radius\n908:         let y = center.y + sin(angle) * radius\n909: \n910:         artLayers[artLayerIndex].position = CGPoint(x: x, y: y)\n911: \n912:         if autoRotateTowardCenter {\n913:             let inwardAngle = atan2(center.y - y, center.x - x)\n914:             artLayers[artLayerIndex].rotation = inwardAngle * 180.0 / .pi\n915:         }\n916:     }\n917: \n918:     func distributeSelectedArtLayersRadially(\n919:         radius: CGFloat,\n920:         autoRotateTowardCenter: Bool,\n921:         angleOffsetDegrees: CGFloat\n922:     ) {\n923:         let targetIDs = orderedSelectedArtLayerIDs().filter { id in\n924:             artLayers.contains(where: { $0.id == id && $0.isVisible })\n925:         }\n926: \n927:         guard !targetIDs.isEmpty else {\n928:             return\n929:         }\n930: \n931:         let center = CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n932:         let stepDirection: CGFloat = radialClockwise ? 1.0 : -1.0\n933:         let baseRadians = (radialStartAngleDegrees + angleOffsetDegrees) * .pi / 180.0\n934:         for (index, id) in targetIDs.enumerated() {\n935:             guard let layerIndex = artLayers.firstIndex(where: { $0.id == id }) else {\n936:                 continue\n937:             }\n938: \n939:             let angle = baseRadians + (stepDirection * 2.0 * .pi * CGFloat(index) / CGFloat(targetIDs.count))\n940:             let x = center.x + cos(angle) * radius\n941:             let y = center.y + sin(angle) * radius\n942: \n943:             artLayers[layerIndex].position = CGPoint(x: x, y: y)\n944: \n945:             if autoRotateTowardCenter {\n946:                 let inwardAngle = atan2(center.y - y, center.x - x)\n947:                 artLayers[layerIndex].rotation = inwardAngle * 180.0 / .pi\n948:             }\n949:         }\n950:     }\n951: \n952:     func duplicateSelectedArtLayerRadially(\n953:         count: Int,\n954:         radius: CGFloat,\n955:         autoRotateTowardCenter: Bool,\n956:         angleOffsetDegrees: CGFloat\n957:     ) {\n958:         guard count > 0, let primaryID = selectedArtLayerID, let primary = artLayers.first(where: { $0.id == primaryID }) else {\n959:             return\n960:         }\n961: \n962:         let center = CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n963:         let stepDirection: CGFloat = radialClockwise ? 1.0 : -1.0\n964:         let baseRadians = (radialStartAngleDegrees + angleOffsetDegrees) * .pi / 180.0\n965:         let nextStartZ = (artLayers.map(\\.zIndex).max() ?? -1) + 1\n966:         let sourceMask = artLayerMasks[primaryID]\n967: \n968:         var newIDs: [UUID] = []\n969: \n970:         // Behavior: create `count` copies and leave the original layer unchanged.\n971:         for index in 0..<count {\n972:             let angle = baseRadians + (stepDirection * 2.0 * .pi * CGFloat(index) / CGFloat(count))\n973:             let x = center.x + cos(angle) * radius\n974:             let y = center.y + sin(angle) * radius\n975: \n976:             let copyID = UUID()\n977:             let copyRotation: CGFloat\n978:             if autoRotateTowardCenter {\n979:                 let inwardAngle = atan2(center.y - y, center.x - x)\n980:                 copyRotation = inwardAngle * 180.0 / .pi\n981:             } else {\n982:                 copyRotation = primary.rotation\n983:             }\n984: \n985:             let copy = ArtLayer(\n986:                 id: copyID,\n987:                 image: primary.image,\n988:                 name: \"\\(primary.name) Copy \\(index + 1)\",\n989:                 isVisible: primary.isVisible,\n990:                 isLocked: primary.isLocked,\n991:                 opacity: primary.opacity,\n992:                 position: CGPoint(x: x, y: y),\n993:                 scale: primary.scale,\n994:                 rotation: copyRotation,\n995:                 zIndex: nextStartZ + index,\n996:                 isGenerated: primary.isGenerated,\n997:                 respectsProtectedCircle: primary.respectsProtectedCircle\n998:             )\n999: \n1000:             artLayers.append(copy)\n1001:             if let sourceMask {\n1002:                 artLayerMasks[copyID] = sourceMask.copy() as? NSImage ?? sourceMask\n1003:             }\n1004:             newIDs.append(copyID)\n1005:         }\n1006: \n1007:         normalizeArtLayerOrder()\n1008:         selectedArtLayerIDs = Set(newIDs)\n1009:         artLayerSelectionOrder = newIDs\n1010:         selectedArtLayerID = newIDs.last\n1011:         syncPrimarySelectionWithMask()\n1012:     }\n1013: \n1014:     func clearGeneratedSelectionAndKeepPrimary() {\n1015:         guard let primary = selectedArtLayerID else {\n1016:             clearArtLayerSelection()\n1017:             return\n1018:         }\n1019:         selectedArtLayerIDs = [primary]\n1020:         artLayerSelectionOrder = [primary]\n1021:         syncPrimarySelectionWithMask()\n1022:     }\n1023: \n1024:     func setSelectedLayerOpacity(_ value: Double) {\n1025:         guard let index = selectedArtLayerIndex else {\n1026:             return\n1027:         }\n1028: \n1029:         artLayers[index].opacity = max(0.0, min(1.0, value))\n1030:     }\n1031: \n1032:     func setSelectedLayerScale(_ value: CGFloat) {\n1033:         guard let index = selectedArtLayerIndex else {\n1034:             return\n1035:         }\n1036: \n1037:         artLayers[index].scale = max(0.1, min(8.0, value))\n1038:     }\n1039: \n1040:     func setSelectedLayerRotation(_ value: CGFloat) {\n1041:         guard let index = selectedArtLayerIndex else {\n1042:             return\n1043:         }\n1044: \n1045:         artLayers[index].rotation = value\n1046:     }\n1047: \n1048:     func toggleSelectedLayerVisibility() {\n1049:         guard let index = selectedArtLayerIndex else {\n1050:             return\n1051:         }\n1052: \n1053:         artLayers[index].isVisible.toggle()\n1054:     }\n1055: \n1056:     func toggleSelectedLayerLock() {\n1057:         guard let index = selectedArtLayerIndex else {\n1058:             return\n1059:         }\n1060: \n1061:         artLayers[index].isLocked.toggle()\n1062:     }\n1063: \n1064:     func createGuideCircle() {\n1065:         let circle = GuideCircle(\n1066:             center: CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0),\n1067:             radius: estimatedOuterChartRadius,\n1068:             name: \"Guide Circle \\(guideCircles.count + 1)\",\n1069:             snapsToChartCircle: false\n1070:         )\n1071:         guideCircles.append(circle)\n1072:         selectedGuideCircleID = circle.id\n1073:     }\n1074: \n1075:     func removeGuide