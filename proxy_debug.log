ss` for services/view models.\n- Use `enum` with `CaseIterable`, `Identifiable`, `Codable` as needed.\n- Keep access control explicit: use `private` for internals, `let` for constants.\n- Use `@MainActor` on view models that mutate UI state.\n- Keep properties grouped by purpose (UI state, selection, services, caching).\n- Use `@Published` for observable state on `ObservableObject` types.\n- Prefer `private(set)` for read-only published state that should only mutate internally.\n\n### Imports\n\n- Import only what you need.\n- Follow the repo pattern: AppKit/Foundation/Combine/SwiftUI listed explicitly.\n- Keep import blocks small and ordered consistently within a file (alphabetical within the chosen order).\n\n### Formatting\n\n- 4-space indentation.\n- Use guard statements for early exits.\n- Prefer multi-line parameter lists when they improve readability.\n- Keep lines short enough to read without horizontal scrolling.\n- Use trailing closure syntax only when it improves readability.\n\n### Naming\n\n- Types: UpperCamelCase (`GenerationSettings`, `LocalServerGenerationService`).\n- Properties/functions: lowerCamelCase (`selectedArtLayerID`, `updateServerHost`).\n- Boolean properties use `is/has/can/should` prefixes (`isVisible`, `canGenerateForCurrentMode`).\n- Use verbs for actions (`create`, `update`, `toggle`, `clear`, `apply`).\n\n### Error handling\n\n- Use `LocalizedError` for user-facing error strings.\n- Prefer `do/catch` when failures should update UI state.\n- Avoid throwing for flow control; use guard + early return.\n- Store user-visible errors in view models (`lastErrorMessage`).\n\n### Async/concurrency\n\n- Use `Task {}` for async work triggered by UI actions.\n- Keep async methods returning `async throws` in services.\n- Use `@Sendable` closures for status/progress handlers.\n\n### SwiftUI patterns\n\n- Views are lightweight and delegate logic to view models/services.\n- State is owned in view models (`EditorViewModel`, `AppSettingsViewModel`).\n- Use `@StateObject` for view model ownership in root views.\n- Use `@State` for local view state (e.g., sheet visibility).\n- Keep `View` bodies declarative; move side-effects into view models.\n\n### Data/model patterns\n\n- Codable structs are used for persistence (`ZFSProjectManifest`, records).\n- Use explicit init overloads to handle migrations/defaults.\n- Use `UUID` for identity and stable ordering via `zIndex`/`order`.\n\n### Services\n\n- Protocol-first design for generation backends (`GenerationServiceProtocol`).\n- Services are simple, synchronous APIs unless network/IO is required.\n- Prefer dependency injection in view models (see `EditorViewModel` init).\n- Keep services free of SwiftUI dependencies.\n\n### UI/state consistency\n\n- Normalize selection state after mutations.\n- Keep selection ordering arrays in sync with sets.\n- Clamp user-controlled numeric values (e.g., scales, radii, timeouts).\n\n## Project Structure\n\n- `FrameCreator/Views/`: SwiftUI views.\n- `FrameCreator/ViewModels/`: ObservableObject state containers.\n- `FrameCreator/Models/`: Data models and Codable project state.\n- `FrameCreator/Services/`: IO, generation, import/export services.\n- `FrameCreator/Utilities/`: Image and mask helpers.\n\n## Configuration and rules\n\n- No Cursor rules found in `.cursor/rules/` or `.cursorrules`.\n- No GitHub Copilot rules found in `.github/copilot-instructions.md`.\n\n## Notes for agents\n\n- This is a macOS app; many APIs are AppKit (`NSImage`, `NSSavePanel`, `NSBezierPath`).\n- Use `CGFloat`/`CGPoint`/`CGSize` for geometry, not `Double`.\n- Keep migration logic in view models or decoding init where needed.\n- Do not add new dependencies without confirming build impact.\n- Avoid writing binary assets; use existing assets or generate at runtime.\n- Avoid touching user data migration unless explicitly needed.\n- For UI tests, use `FrameCreatorUITests/FrameCreatorUITests/testName` format.\n- When creating new models, use `struct` with `Identifiable` and `Codable`.\n- For view models that mutate state, use `@MainActor final class` conforming to `ObservableObject`.\n- Use `@Published` for state that should trigger UI updates.\n- Keep services stateless where possible; use dependency injection.\n","role":"system"},"last_message":{"content":"<path>/Users/michaelmarler/Projects/FrameCreator/FrameCreator/Automation/DebugAutomationService.swift</path>\n<type>file</type>\n<content>1: #if DEBUG\n2: import Combine\n3: import Foundation\n4: \n5: @MainActor\n6: final class DebugAutomationService: ObservableObject {\n7:     @Published var snapshot: AutomationSnapshot?\n8:     @Published var commandResults: [AutomationCommandResult] = []\n9:     \n10:     @Published var isAutomationEnabled: Bool = false\n11:     @Published var commandInput: String = \"\"\n12:     \n13:     private weak var stateStore: DebugTestStateStore?\n14:     \n15:     init(stateStore: DebugTestStateStore) {\n16:         self.stateStore = stateStore\n17:     }\n18:     \n19:     var snapshotJSONString: String {\n20:         guard let snapshot else { return \"No snapshot available\" }\n21:         return snapshot.toJSONString() ?? \"Failed to serialize snapshot\"\n22:     }\n23:     \n24:     var lastCommandResultJSONString: String {\n25:         guard let result = commandResults.last else { return \"No command results\" }\n26:         return result.toJSONString() ?? \"Failed to serialize command result\"\n27:     }\n28: \n29:     func refreshSnapshot(using viewModel: EditorViewModel) {\n30:         snapshot = buildSnapshot(from: viewModel)\n31:     }\n32: \n33:     func refreshDetailedSnapshot(using viewModel: EditorViewModel) {\n34:         snapshot = buildSnapshot(from: viewModel)\n35:     }\n36: \n37:     private func buildSnapshot(from viewModel: EditorViewModel) -> AutomationSnapshot {\n38:         let layers = viewModel.layers.map { layer in\n39:             LayerSummary(\n40:                 id: layer.id.uuidString,\n41:                 name: layer.name,\n42:                 isVisible: layer.isVisible,\n43:                 isGenerated: layer.isGenerated,\n44:                 zIndex: layer.zIndex\n45:             )\n46:         }\n47: \n48:         let protectedCircleSummary: ProtectedCircleSummary?\n49:         if let protectedCircle = viewModel.protectedCircle {\n50:             protectedCircleSummary = ProtectedCircleSummary(\n51:                 id: protectedCircle.id.uuidString,\n52:                 name: \"Protected Circle\",\n53:                 centerX: protectedCircle.center.x,\n54:                 centerY: protectedCircle.center.y,\n55:                 radius: protectedCircle.radius,\n56:                 isVisible: protectedCircle.isVisible\n57:             )\n58:         } else {\n59:             protectedCircleSummary = nil\n60:         }\n61: \n62:         let chartGeometrySummary: ChartGeometrySummary?\n63:         if let chartGeometry = viewModel.chartGeometry {\n64:             chartGeometrySummary = ChartGeometrySummary(\n65:                 centerX: chartGeometry.center.x,\n66:                 centerY: chartGeometry.center.y,\n67:                 outerRadius: chartGeometry.outerRadius,\n68:                 innerRadius: chartGeometry.innerRadius\n69:             )\n70:         } else {\n71:             chartGeometrySummary = nil\n72:         }\n73: \n74:         return AutomationSnapshot(\n75:             layerSummaries: layers,\n76:             selectedLayerID: viewModel.selectedLayer?.id.uuidString,\n77:             protectedCirclePresent: viewModel.protectedCircle != nil,\n78:             protectedCircle: protectedCircleSummary,\n79:             chartGeometry: chartGeometrySummary,\n80:             chartBaseImageLoaded: viewModel.chartBaseImage != nil,\n81:             maskLoaded: viewModel.mask != nil,\n82:             lastError: nil,\n83:             lastSaveResult: nil,\n84:             lastLoadResult: nil,\n85:             lastExportResult: nil,\n86:             lastGenerated