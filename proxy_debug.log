  ]\n813: \n814:         if let flattenedID = artLayers.first?.id {\n815:             artLayerMasks = [flattenedID: MaskUtilities.makeWhiteMask(size: flattened.size)]\n816:             selectArtLayer(id: flattenedID)\n817:         }\n818:     }\n819: \n820:     func moveSelectedLayer(delta: CGSize) {\n821:         guard let index = selectedArtLayerIndex else {\n822:             return\n823:         }\n824: \n825:         artLayers[index].position.x += delta.width\n826:         artLayers[index].position.y += delta.height\n827:     }\n828: \n829:     func centerSelectedArtLayer() {\n830:         guard let index = selectedArtLayerIndex else {\n831:             return\n832:         }\n833: \n834:         artLayers[index].position = CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n835:     }\n836: \n837:     func fitSelectedArtLayerToCanvas() {\n838:         guard let index = selectedArtLayerIndex else {\n839:             return\n840:         }\n841: \n842:         let imageSize = artLayers[index].image.size\n843:         guard imageSize.width > 0, imageSize.height > 0 else {\n844:             return\n845:         }\n846: \n847:         let baseRect = fittedRect(for: imageSize, inside: CGSize(width: canvasSize, height: canvasSize))\n848:         let longestSide = max(baseRect.width, baseRect.height)\n849:         guard longestSide > 0 else {\n850:             return\n851:         }\n852: \n853:         let fitScale = canvasSize / longestSide\n854:         artLayers[index].scale = max(0.1, min(8.0, fitScale))\n855:         centerSelectedArtLayer()\n856:     }\n857: \n858:     func normalizeSelectedArtLayerScale() {\n859:         guard let index = selectedArtLayerIndex else {\n860:             return\n861:         }\n862: \n863:         artLayers[index].scale = 1.0\n864:     }\n865: \n866:     func centerAllArtLayers() {\n867:         let centerPoint = CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n868:         for index in artLayers.indices {\n869:             artLayers[index].position = centerPoint\n870:         }\n871:     }\n872: \n873:     func scaleSelectedLayer(factor: CGFloat) {\n874:         guard let index = selectedArtLayerIndex else {\n875:             return\n876:         }\n877: \n878:         artLayers[index].scale = max(0.1, min(8.0, artLayers[index].scale * factor))\n879:     }\n880: \n881:     func rotateSelectedLayer(angle: CGFloat) {\n882:         guard let index = selectedArtLayerIndex else {\n883:             return\n884:         }\n885: \n886:         artLayers[index].rotation += angle\n887:     }\n888: \n889:     func toggleSelectedArtLayerProtectedCircleRespect() {\n890:         guard let index = selectedArtLayerIndex else {\n891:             return\n892:         }\n893: \n894:         artLayers[index].respectsProtectedCircle.toggle()\n895:     }\n896: \n897:     // Angle convention: point index 0 starts at radialStartAngleDegrees and advances by radialClockwise.\n898:     func placeSelectedArtLayerOnRadialPoint(count: Int, index: Int, radius: CGFloat, autoRotateTowardCenter: Bool) {\n899:         guard count > 0, let artLayerIndex = selectedArtLayerIndex else {\n900:             return\n901:         }\n902: \n903:         let center = CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n904:         let normalizedIndex = ((index % count) + count) % count\n905:         let stepDirection: CGFloat = radialClockwise ? 1.0 : -1.0\n906:         let angle = (radialStartAngleDegrees * .pi / 180.0) + (stepDirection * 2.0 * .pi * CGFloat(normalizedIndex) / CGFloat(count))\n907:         let x = center.x + cos(angle) * radius\n908:         let y = center.y + sin(angle) * radius\n909: \n910:         artLayers[artLayerIndex].position = CGPoint(x: x, y: y)\n911: \n912:         if autoRotateTowardCenter {\n913:             let inwardAngle = atan2(center.y - y, center.x - x)\n914:             artLayers[artLayerIndex].rotation = inwardAngle * 180.0 / .pi\n915:         }\n916:     }\n917: \n918:     func distributeSelectedArtLayersRadially(\n919:         radius: CGFloat,\n920:         autoRotateTowardCenter: Bool,\n921:         angleOffsetDegrees: CGFloat\n922:     ) {\n923:         let targetIDs = orderedSelectedArtLayerIDs().filter { id in\n924:             artLayers.contains(where: { $0.id == id && $0.isVisible })\n925:         }\n926: \n927:         guard !targetIDs.isEmpty else {\n928:             return\n929:         }\n930: \n931:         let center = CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n932:         let stepDirection: CGFloat = radialClockwise ? 1.0 : -1.0\n933:         let baseRadians = (radialStartAngleDegrees + angleOffsetDegrees) * .pi / 180.0\n934:         for (index, id) in targetIDs.enumerated() {\n935:             guard let layerIndex = artLayers.firstIndex(where: { $0.id == id }) else {\n936:                 continue\n937:             }\n938: \n939:             let angle = baseRadians + (stepDirection * 2.0 * .pi * CGFloat(index) / CGFloat(targetIDs.count))\n940:             let x = center.x + cos(angle) * radius\n941:             let y = center.y + sin(angle) * radius\n942: \n943:             artLayers[layerIndex].position = CGPoint(x: x, y: y)\n944: \n945:             if autoRotateTowardCenter {\n946:                 let inwardAngle = atan2(center.y - y, center.x - x)\n947:                 artLayers[layerIndex].rotation = inwardAngle * 180.0 / .pi\n948:             }\n949:         }\n950:     }\n951: \n952:     func duplicateSelectedArtLayerRadially(\n953:         count: Int,\n954:         radius: CGFloat,\n955:         autoRotateTowardCenter: Bool,\n956:         angleOffsetDegrees: CGFloat\n957:     ) {\n958:         guard count > 0, let primaryID = selectedArtLayerID, let primary = artLayers.first(where: { $0.id == primaryID }) else {\n959:             return\n960:         }\n961: \n962:         let center = CGPoint(x: canvasSize / 2.0, y: canvasSize / 2.0)\n963:         let stepDirection: CGFloat = radialClockwise ? 1.0 : -1.0\n964:         let baseRadians = (radialStartAngleDegrees + angleOffsetDegrees) * .pi / 180.0\n965:         let nextStartZ = (artLayers.map(\\.zIndex).max() ?? -1) + 1\n966:         let sourceMask = artLayerMasks[primaryID]\n967: \n968:         var newIDs: [UUID] = []\n969: \n970:         // Behavior: create `count` copies and leave the original layer unchanged.\n971:         for index in 0..<count {\n972:             let angle = baseRadians + (stepDirection * 2.0 * .pi * CGFloat(index) / CGFloat(count))\n973:             let x = center.x + cos(angle) * radius\n974:             let y = center.y + sin(angle) * radius\n975: \n976:             let copyID = UUID()\n977:             let copyRotation: CGFloat\n978:             if autoRotateTowardCenter {\n979:                 let inwardAngle = atan2(center.y - y, center.x - x)\n980:                 copyRotation = inwardAngle * 180.0 / .pi\n981:             } else {\n982:                 copyRotation = primary.rotation\n983:             }\n984: \n985:             let copy = ArtLayer(\n986:                 id: copyID,\n987:                 image: primary.image,\n988:                 name: \"\\(primary.name) Copy \\(index + 1)\",\n989:                 isVisible: primary.isVisible,\n990:                 isLocked: primary.isLocked,\n991:                 opacity: primary.opacity,\n992:                 position: CGPoint(x: x, y: y),\n993:                 scale: primary.scale,\n994:                 rotation: copyRotation,\n995:                 zIndex: nextStartZ + index,\n996:                 isGenerated: primary.isGenerated,\n997:                 respectsProtectedCircle: primary.respectsProtectedCircle\n998:             )\n999: \n1000:             artLayers.append(copy)\n1001:             if let sourceMask {\n1002:                 artLayerMasks[copyID] = sourceMask.copy() as? NSImage ?? sourceMask\n1003:             }\n1004:             newIDs.append(copyID)\n1005:         }\n1006: \n1007:         normalizeArtLayerOrder()\n1008:         selectedArtLa