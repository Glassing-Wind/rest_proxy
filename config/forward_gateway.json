{
  "bypasses": [
    {
      "matchers": [
        "*:1082",
        "*:18080",
        "*:18081",
        "localhost",
        "localhost.",
        ".localhost",
        "*.localhost",
        "localhost.localdomain",
        "*.localhost.localdomain",
        "*.local",
        "0.0.0.0/8",
        "10.0.0.0/8",
        "100.64.0.0/10",
        "127.0.0.0/8",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.0.2.0/24",
        "192.88.99.0/24",
        "192.168.0.0/16",
        "198.18.0.0/15",
        "198.51.100.0/24",
        "203.0.113.0/24",
        "224.0.0.0/4",
        "240.0.0.0/4",
        "::/96",
        "::1/128",
        "::ffff:0:0/96",
        "64:ff9b::/96",
        "64:ff9b:1::/48",
        "100::/64",
        "2001::/23",
        "2001:db8::/32",
        "2002::/16",
        "3fff::/20",
        "5f00::/16",
        "fc00::/7",
        "fe80::/10",
        "ff00::/8"
      ],
      "name": "deny-local-and-reentry",
      "whitelist": false
    }
  ],
  "log": {
    "level": "error",
    "output": "none"
  },
  "resolvers": [
    {
      "name": "existing-wifi-dns",
      "nameservers": [
        {
          "addr": "udp://192.168.1.1:53"
        }
      ]
    }
  ],
  "services": [
    {
      "addr": "127.0.0.1:18080",
      "bypass": "deny-local-and-reentry",
      "handler": {
        "metadata": {
          "sniffing": false,
          "udp": false
        },
        "type": "http"
      },
      "listener": {
        "type": "tcp"
      },
      "metadata": {
        "interface": "en0"
      },
      "name": "rest-proxy-forward-gateway",
      "resolver": "existing-wifi-dns"
    },
    {
      "addr": "127.0.0.1:18081",
      "bypass": "deny-local-and-reentry",
      "handler": {
        "metadata": {
          "bind": false,
          "notls": true,
          "sniffing": false,
          "udp": true,
          "udpBufferSize": 65535
        },
        "type": "socks5"
      },
      "listener": {
        "type": "tcp"
      },
      "metadata": {
        "interface": "en0"
      },
      "name": "rest-proxy-socks-gateway",
      "resolver": "existing-wifi-dns"
    }
  ]
}
